# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Carpetas de compilación (nunca van al repositorio)
target/
build/
.gradle/

# El *.jar de arriba ignora todos los .jar, pero el wrapper de Gradle SÍ debe subirse.
# Esta excepción tiene que ir DESPUÉS de *.jar.
!gradle/wrapper/gradle-wrapper.jar

# Variables locales con secretos
.env

# Datos locales de la base (docker-compose.datos-locales.yml)
datos/
